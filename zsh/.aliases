#!/bin/zsh
_delim="\t------\t"
_spy_description="\tspy${_delim}source python environment (git root by default)\n"
_fan_on_description="\tfan_on${_delim}turn on fan(raspberry pi only)\n"
_fan_off_description="\tfan_on${_delim}turn off fan(raspberry pi only)\n"
_show_installed_plugins_description="\tsip${_delim}show installed plugins\n"
_install_plugins_description="\tip${_delim}install plugins\n"
_config_description="\tcf${_delim}cd into cf directory"
_descriptions=("Aliases:\n" "$_spy_description" "$_fan_on_description" "$_fan_off_description" "$_show_installed_plugins_description" "$_install_plugins_description" )


this=${(%):-%x}

function _make_descriptions() {
    [ -f /tmp/alias_descriptions ] && rm /tmp/alias_descriptions
    for description in "${_descriptions[@]}"; do
        printf "%s" "$description" >> /tmp/alias_descriptions
    done
}


if [ ! -f /tmp/alias_descriptions ] || [ $this -nt /tmp/alias_descriptions ];
then
    _make_descriptions
fi

description="$(cat /tmp/alias_descriptions)"

function spy() {
    local root candidate

    if [ -n "$1" ]; then
        root="$1"
    else
        root="$(git rev-parse --show-toplevel 2>/dev/null)"
        [ -z "$root" ] && root="$PWD"
    fi

    # The path handed in may be the environment itself.
    if [ -f "$root/bin/activate" ]; then
        source "$root/bin/activate"
        return
    fi

    for candidate in "$root"/.venv "$root"/venv "$root"/env "$root"/.env; do
        if [ -f "$candidate/bin/activate" ]; then
            source "$candidate/bin/activate"
            echo "spy: $candidate"
            return
        fi
    done

    echo "spy: no python environment under $root" >&2
    return 1
}

function fan_on() {
    pinctrl FAN_PWM op dl
}

function fan_off() {
    pinctrl FAN_PWM op dh
}

function config() {
    parent="$(dirname "$(dirname "$(readlink -f "$this")")")"
    cd "$parent"
}

alias sip='show_installed_plugins'
alias ip='install_plugins'
alias help='echo "$description"'
alias cf='config'
